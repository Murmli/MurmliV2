{
  "format": 1,
  "id": "shopping/items/clearing-keeps-unknown-items",
  "rule": "https://github.com/Murmli/MurmliV2/issues/141 Abgehakte entfernen, Liste leeren: Was das Gerät nicht kannte, bleibt (57)",
  "dataTypes": ["shoppingList", "shoppingListItem"],
  "devices": { "phone": { "account": "alice" }, "tablet": { "account": "alice" } },
  "given": [
    { "device": "phone", "kind": "create", "dataType": "shoppingList", "scope": "list", "record": "list", "at": -60000, "fields": { "name": "Einkauf" } },
    { "device": "phone", "kind": "create", "dataType": "shoppingListItem", "scope": "list", "record": "milk", "at": -50000, "fields": { "name": "Milch", "category": "dairy", "language": "de" } }
  ],
  "race": [
    { "label": "clear", "device": "phone", "kind": "delete", "dataType": "shoppingListItem", "scope": "list", "record": "milk", "at": -2000 },
    { "label": "add", "device": "tablet", "kind": "create", "dataType": "shoppingListItem", "scope": "list", "record": "bread", "at": -1000, "fields": { "name": "Brot", "category": "bakery", "language": "de" } }
  ],
  "expect": {
    "results": { "clear": { "status": "applied" }, "add": { "status": "applied" } },
    "records": [ { "dataType": "shoppingListItem", "record": "bread", "fields": { "name": "Brot" } } ],
    "absent": [ { "dataType": "shoppingListItem", "record": "milk" } ]
  },
  "expectByOrder": {}
}
