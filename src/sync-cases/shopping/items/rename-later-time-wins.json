{
  "format": 1,
  "id": "shopping/items/rename-later-time-wins",
  "rule": "https://github.com/Murmli/MurmliV2/issues/141 Je Feld gewinnt die spätere Gerätezeit (8)",
  "dataTypes": ["shoppingList", "shoppingListItem"],
  "devices": { "phone": { "account": "alice" }, "tablet": { "account": "alice" } },
  "given": [
    { "device": "phone", "kind": "create", "dataType": "shoppingList", "scope": "list", "record": "list", "at": -60000, "fields": { "name": "Einkauf" } },
    { "device": "phone", "kind": "create", "dataType": "shoppingListItem", "scope": "list", "record": "milk", "at": -50000, "fields": { "name": "Milch", "category": "dairy", "language": "de" } }
  ],
  "race": [
    { "label": "older", "device": "phone", "kind": "setFields", "dataType": "shoppingListItem", "scope": "list", "record": "milk", "at": -2000, "fields": { "name": "Hafermilch" } },
    { "label": "newer", "device": "tablet", "kind": "setFields", "dataType": "shoppingListItem", "scope": "list", "record": "milk", "at": -1000, "fields": { "name": "Sojamilch" } }
  ],
  "expect": {
    "results": { "older": { "status": "applied" }, "newer": { "status": "applied" } },
    "records": [ { "dataType": "shoppingListItem", "record": "milk", "fields": { "name": "Sojamilch" } } ],
    "absent": []
  },
  "expectByOrder": {
    "newer>older": { "results": { "older": { "status": "ignored", "cause": "lostToNewer" }, "newer": { "status": "applied" } } }
  }
}
