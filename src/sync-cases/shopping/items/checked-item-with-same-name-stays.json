{
  "format": 1,
  "id": "shopping/items/checked-item-with-same-name-stays",
  "rule": "https://github.com/Murmli/MurmliV2/issues/141 Gibt es den Artikel schon abgehakt, bleibt er, und ein neuer entsteht (55b); abgehakte Artikel lassen sich ohne Sonderregel ändern (121a)",
  "dataTypes": ["shoppingList", "shoppingListItem"],
  "devices": { "phone": { "account": "alice" }, "tablet": { "account": "alice" } },
  "given": [
    { "device": "phone", "kind": "create", "dataType": "shoppingList", "scope": "list", "record": "list", "at": -60000, "fields": { "name": "Einkauf" } },
    { "device": "phone", "kind": "create", "dataType": "shoppingListItem", "scope": "list", "record": "milk", "at": -50000, "fields": { "name": "Milch", "category": "dairy", "language": "de", "checked": true } }
  ],
  "race": [
    { "label": "add", "device": "phone", "kind": "create", "dataType": "shoppingListItem", "scope": "list", "record": "newMilk", "at": -2000, "fields": { "name": "Milch", "category": "dairy", "language": "de" } },
    { "label": "rename", "device": "tablet", "kind": "setFields", "dataType": "shoppingListItem", "scope": "list", "record": "milk", "at": -1000, "fields": { "name": "Vollmilch" } }
  ],
  "expect": {
    "results": { "add": { "status": "applied" }, "rename": { "status": "applied" } },
    "records": [ { "dataType": "shoppingListItem", "record": "milk", "fields": { "name": "Vollmilch", "checked": true } }, { "dataType": "shoppingListItem", "record": "newMilk", "fields": { "name": "Milch", "checked": false } } ],
    "absent": []
  },
  "expectByOrder": {}
}
