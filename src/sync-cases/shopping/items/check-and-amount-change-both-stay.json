{
  "format": 1,
  "id": "shopping/items/check-and-amount-change-both-stay",
  "rule": "https://github.com/Murmli/MurmliV2/issues/141 Hakt A einen Artikel ab und ändert B seine Menge von 1 l auf 2 l, bleibt er abgehakt und zeigt 2 l (52)",
  "dataTypes": ["shoppingList", "shoppingListItem"],
  "devices": { "phone": { "account": "alice" }, "tablet": { "account": "alice" } },
  "given": [
    { "device": "phone", "kind": "create", "dataType": "shoppingList", "scope": "list", "record": "list", "at": -60000, "fields": { "name": "Einkauf" } },
    { "device": "phone", "kind": "create", "dataType": "shoppingListItem", "scope": "list", "record": "milk", "at": -50000, "fields": { "name": "Milch", "category": "dairy", "language": "de", "quantity": 1, "unit": "liter" } }
  ],
  "race": [
    { "label": "check", "device": "phone", "kind": "setFields", "dataType": "shoppingListItem", "scope": "list", "record": "milk", "at": -2000, "fields": { "checked": true } },
    { "label": "amount", "device": "tablet", "kind": "setFields", "dataType": "shoppingListItem", "scope": "list", "record": "milk", "at": -1000, "fields": { "quantity": 2, "unit": "liter" } }
  ],
  "expect": {
    "results": { "check": { "status": "applied" }, "amount": { "status": "applied" } },
    "records": [ { "dataType": "shoppingListItem", "record": "milk", "fields": { "checked": true, "quantity": 2, "unit": "liter" } } ],
    "absent": []
  },
  "expectByOrder": {}
}
