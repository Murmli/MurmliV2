{
  "format": 1,
  "id": "core/creation/create-on-existing-id-acts-as-set-fields",
  "rule": "https://github.com/Murmli/MurmliV2/issues/122 create auf eine vorhandene ID im selben Bereich wirkt wie setFields mit allen gesendeten Gruppen",
  "dataTypes": ["testNote"],
  "devices": { "phone": { "account": "alice" }, "tablet": { "account": "alice" } },
  "given": [],
  "race": [
    { "label": "phone", "device": "phone", "kind": "create", "dataType": "testNote", "scope": "$personal", "record": "note", "at": -2000, "fields": { "title": "phone" } },
    { "label": "tablet", "device": "tablet", "kind": "create", "dataType": "testNote", "scope": "$personal", "record": "note", "at": -1000, "fields": { "title": "tablet", "color": "red", "weight": 1 } }
  ],
  "expect": {
    "results": { "phone": { "status": "applied" }, "tablet": { "status": "applied" } },
    "records": [ { "dataType": "testNote", "record": "note", "fields": { "title": "tablet", "color": "red", "weight": 1 } } ],
    "absent": []
  },
  "expectByOrder": {
    "tablet>phone": { "results": { "phone": { "status": "ignored", "cause": "lostToNewer" }, "tablet": { "status": "applied" } } }
  }
}
