{
  "format": 1,
  "id": "core/conflicts/older-group-change-loses",
  "rule": "https://github.com/Murmli/MurmliV2/issues/122 Felder einer Gruppe gewinnen oder verlieren nur gemeinsam",
  "dataTypes": ["testBoard", "testCard"],
  "devices": { "phone": { "account": "alice" }, "tablet": { "account": "alice" } },
  "given": [
    { "device": "phone", "kind": "create", "dataType": "testBoard", "scope": "board", "record": "board", "at": -60000, "fields": { "title": "Groceries" } },
    { "device": "phone", "kind": "create", "dataType": "testCard", "scope": "board", "record": "card", "at": -50000, "fields": { "text": "milk" } }
  ],
  "race": [
    { "label": "newer", "device": "phone", "kind": "setFields", "dataType": "testCard", "scope": "board", "record": "card", "at": -1000, "fields": { "count": 2, "measure": "liter" } },
    { "label": "older", "device": "tablet", "kind": "setFields", "dataType": "testCard", "scope": "board", "record": "card", "at": -2000, "fields": { "count": 3, "measure": null } }
  ],
  "expect": {
    "results": { "newer": { "status": "applied" }, "older": { "status": "applied" } },
    "records": [ { "dataType": "testCard", "record": "card", "fields": { "count": 2, "measure": "liter" } } ],
    "absent": []
  },
  "expectByOrder": {
    "newer>older": { "results": { "newer": { "status": "applied" }, "older": { "status": "ignored", "cause": "lostToNewer" } } }
  }
}
