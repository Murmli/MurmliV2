{
  "format": 1,
  "id": "core/scopes/concurrent-root-create-same-id",
  "rule": "https://github.com/Murmli/MurmliV2/issues/122 Nur Anlegen des Wurzel-Datensatzes legt einen Bereich an, ein weiteres Anlegen derselben ID wirkt wie setFields",
  "dataTypes": ["testBoard", "testCard"],
  "devices": { "phone": { "account": "alice" }, "tablet": { "account": "alice" } },
  "given": [],
  "race": [
    { "label": "phone", "device": "phone", "kind": "create", "dataType": "testBoard", "scope": "board", "record": "board", "at": -2000, "fields": { "title": "phone" } },
    { "label": "tablet", "device": "tablet", "kind": "create", "dataType": "testBoard", "scope": "board", "record": "board", "at": -1000, "fields": { "title": "tablet" } }
  ],
  "expect": {
    "results": { "phone": { "status": "applied" }, "tablet": { "status": "applied" } },
    "records": [ { "dataType": "testBoard", "record": "board", "fields": { "title": "tablet" } } ],
    "absent": []
  },
  "expectByOrder": {
    "tablet>phone": { "results": { "phone": { "status": "ignored", "cause": "lostToNewer" }, "tablet": { "status": "applied" } } }
  }
}
