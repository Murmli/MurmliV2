  "fixed_sql": [
    {
      "name": "shopping_lists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shopping_lists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "shopping_list_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shopping_list_items\" (\"id\" TEXT NOT NULL, \"scope_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"quantity\" REAL NULL, \"unit\" TEXT NULL, \"category\" TEXT NOT NULL, \"checked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"checked\" IN (0, 1)), \"language\" TEXT NOT NULL, \"created_at\" INTEGER NULL, \"changed_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "shopping_list_item_recipes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shopping_list_item_recipes\" (\"item_id\" TEXT NOT NULL REFERENCES shopping_list_items (id) ON DELETE CASCADE, \"recipe_id\" TEXT NOT NULL, \"recipe_title\" TEXT NOT NULL, \"quantity\" REAL NULL, PRIMARY KEY (\"item_id\", \"recipe_id\"));"
        }
      ]
    },
    {
      "name": "shopping_category_positions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shopping_category_positions\" (\"category\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"category\"));"
        }
      ]
    },
    {
      "name": "sync_commands",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_commands\" (\"sequence\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"id\" TEXT NOT NULL UNIQUE, \"kind\" TEXT NOT NULL, \"scope_id\" TEXT NOT NULL, \"data_type\" TEXT NOT NULL, \"record_id\" TEXT NOT NULL, \"fields\" TEXT NULL, \"time\" INTEGER NOT NULL, \"failed_attempts\" INTEGER NOT NULL DEFAULT 0, \"first_failed_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "sync_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_states\" (\"id\" INTEGER NOT NULL, \"account_id\" TEXT NULL, \"device_id\" TEXT NULL, \"token\" TEXT NULL, \"last_command_time\" INTEGER NULL, \"clock_offset_milliseconds\" INTEGER NOT NULL DEFAULT 0, \"poll_interval_seconds\" INTEGER NULL, \"max_commands_per_request\" INTEGER NULL, \"max_request_bytes\" INTEGER NULL, \"local_state_generation\" INTEGER NOT NULL DEFAULT 0, \"first_sync_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"first_sync_completed\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK (id = 1));"
